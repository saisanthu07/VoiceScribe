# Client Environment Variables — Copy this to .env and fill in your values

# Nhost project subdomain — found in Nhost console dashboard URL
VITE_NHOST_SUBDOMAIN=your_nhost_subdomain_here

# Nhost region (e.g., ap-south-1, eu-central-1, us-east-1)
VITE_NHOST_REGION=your_nhost_region_here

# Backend URL (Express server)
VITE_BACKEND_URL=http://localhost:5000
