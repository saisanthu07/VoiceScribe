# Server Environment Variables — Copy this to .env and fill in your values

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/deepgram_nhost?retryWrites=true&w=majority

# Nhost JWT secret — found in Nhost console > Settings > Hasura > JWT Secret
# It should be the "key" value from the JWT secret JSON object
NHOST_JWT_SECRET=your_nhost_jwt_secret_here

# Deepgram API key — get from https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
